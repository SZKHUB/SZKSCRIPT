local Lighting = game:GetService("Lighting")
local Perf = {token = 0, orig = setmetatable({}, {__mode = "k"}), light = nil, conn = nil, restoring = false}
local function perfApply(obj)
	if obj:IsA("Decal") then Perf.orig[obj] = Perf.orig[obj] or {Transparency = obj.Transparency}; obj.Transparency = 1
	elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("PostEffect") then
		Perf.orig[obj] = Perf.orig[obj] or {Enabled = obj.Enabled}; obj.Enabled = false
	elseif obj:IsA("Terrain") then return
	elseif obj:IsA("BasePart") then Perf.orig[obj] = Perf.orig[obj] or {CastShadow = obj.CastShadow, Material = obj.Material}; obj.CastShadow = false; obj.Material = Enum.Material.Plastic
	elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then Perf.orig[obj] = Perf.orig[obj] or {Shadows = obj.Shadows}; obj.Shadows = false end
end
local function perfEnable()
	Perf.token += 1; local token = Perf.token
	task.spawn(function()
		while Perf.restoring do task.wait() end
		if Perf.token ~= token then return end
		Perf.light = Perf.light or {GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd, OutdoorAmbient = Lighting.OutdoorAmbient, Brightness = Lighting.Brightness, Ambient = Lighting.Ambient}
		Lighting.GlobalShadows = false; Lighting.FogEnd = 999999; Lighting.OutdoorAmbient = Color3.new(0, 0, 0); Lighting.Brightness = 2; Lighting.Ambient = Color3.new(0.2, 0.2, 0.2)
		if Perf.conn then Perf.conn:Disconnect() end
		Perf.conn = game.DescendantAdded:Connect(function(o) if Perf.token == token then pcall(perfApply, o) end end)
		local list = game:GetDescendants()
		for i, obj in ipairs(list) do if Perf.token ~= token then return end; pcall(perfApply, obj); if i % 500 == 0 then task.wait() end end
		Notify("Performance", "Lag removed", 2.5, "success")
	end)
end
local function perfDisable()
	Perf.token += 1
	if Perf.conn then Perf.conn:Disconnect(); Perf.conn = nil end
	if Perf.light then for k, v in pairs(Perf.light) do pcall(function() Lighting[k] = v end) end; Perf.light = nil end
	local list = {}
	for obj, props in pairs(Perf.orig) do list[#list + 1] = {obj, props} end
	Perf.orig = setmetatable({}, {__mode = "k"})
	if #list == 0 then return end
	Perf.restoring = true
	task.spawn(function()
		for i, it in ipairs(list) do
			local obj, props = it[1], it[2]
			if obj.Parent then for k, v in pairs(props) do pcall(function() obj[k] = v end) end end
			if i % 500 == 0 then task.wait() end
		end
		Perf.restoring = false
	end)
end
local origQuality
local function setQuality(on)
	pcall(function()
		local r = settings().Rendering
		if on then origQuality = origQuality or r.QualityLevel; r.QualityLevel = Enum.QualityLevel.Level01
		else r.QualityLevel = origQuality or Enum.QualityLevel.Automatic; origQuality = nil end
	end)
end
local fovConn, origFov
local function setFov(on)
	if fovConn then fovConn:Disconnect(); fovConn = nil end
	local cam = Workspace.CurrentCamera
	if on then
		origFov = origFov or (cam and cam.FieldOfView)
		if cam then cam.FieldOfView = 90 end
		fovConn = RunService.RenderStepped:Connect(function() local c = Workspace.CurrentCamera; if c and c.FieldOfView > 90 then c.FieldOfView = 90 end end)
		Conns[#Conns + 1] = fovConn
	elseif cam and origFov then cam.FieldOfView = origFov; origFov = nil end
end
Gui.Destroying:Connect(function() perfDisable(); if origQuality then setQuality(false) end; setFov(false) end)

