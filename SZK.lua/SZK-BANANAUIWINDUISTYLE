local function LoadAccessoryToPlayer(assetId)
    local char = LP.Character; if not char then return false end
    local success, content = pcall(function() return game:GetObjects("rbxassetid://"..assetId) end)
    if not success or not content or not content[1] then return false end
    local accessory = content[1]
    if not accessory:IsA("Accessory") then
        accessory.Parent = char
        return true
    end
    for _, part in ipairs(accessory:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Massless = true
        end
    end
    local handle = accessory:FindFirstChild("Handle")
    if handle then
        local attachment = handle:FindFirstChildOfClass("Attachment")
        local targetAttachment = nil
        if attachment then
            for _, bodyPart in ipairs(char:GetChildren()) do
                if bodyPart:IsA("BasePart") then
                    local found = bodyPart:FindFirstChild(attachment.Name)
                    if found and found:IsA("Attachment") then
                        targetAttachment = found
                        break
                    end
                end
            end
        end
        if targetAttachment then
            local weld = Instance.new("Weld")
            weld.Part0 = targetAttachment.Parent
            weld.Part1 = handle
            weld.C0 = targetAttachment.CFrame
            weld.C1 = attachment.CFrame
            weld.Parent = handle
        else
            local head = char:FindFirstChild("Head")
            if head then
                local weld = Instance.new("Weld")
                weld.Part0 = head
                weld.Part1 = handle
                weld.C0 = CFrame.new(0,0,0)
                weld.C1 = attachment and attachment.CFrame or CFrame.new()
                weld.Parent = handle
            end
        end
    end
    accessory.Parent = char
    return true
end

