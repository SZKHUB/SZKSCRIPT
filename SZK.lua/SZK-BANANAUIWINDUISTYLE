local function isMySound(s) return s and s.Name and MY_SOUND_NAMES[s.Name] == true end

local function isInMyTool(s)
    if not s or not s.Parent then return false end
    local p = s.Parent; local tool = nil
    while p do if p:IsA("Tool") then tool = p; break end; p = p.Parent end
    if not tool then return false end
    if LP.Character and tool:IsDescendantOf(LP.Character) then return true end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp and tool:IsDescendantOf(bp) then return true end
    return false
end

local function shouldMuteSound(s)
    if not s or not s:IsA("Sound") then return false end
    if isMySound(s) then return false end
    if isInMyTool(s) then return true end
    local char = LP.Character
    if char and s:IsDescendantOf(char) then return true end
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local part = s:FindFirstAncestorWhichIsA("BasePart")
            if part then
                if (part.Position - hrp.Position).Magnitude <= 30 then return true end
            elseif s.Parent and s.Parent:IsA("Attachment") then
                if (s.Parent.WorldPosition - hrp.Position).Magnitude <= 30 then return true end
            end
        end
    end
    return false
end

local function muteSound(s)
    if not s or not s:IsA("Sound") then return end
    if SOUND.MutedSounds[s] == nil then SOUND.MutedSounds[s] = (s.Volume > 0) and s.Volume or 1 end
    pcall(function() s.Volume = 0 end)
end

local function unmuteAllSounds()
    for s, v in pairs(SOUND.MutedSounds) do
        if s and s.Parent then pcall(function() s.Volume = v end) end
    end
    SOUND.MutedSounds = {}
end

local function scanAndMuteSounds()
    local char = LP.Character
    if char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("Sound") and shouldMuteSound(d) then muteSound(d) end
        end
    end
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then
        for _, d in ipairs(bp:GetDescendants()) do
            if d:IsA("Sound") and shouldMuteSound(d) then muteSound(d) end
        end
    end
end

local function ApplyMuteState()
    if SOUND.ShootSoundEnabled and SOUND.MuteOriginalShoot then scanAndMuteSounds()
    else unmuteAllSounds() end
end

local function GetKillSoundIdByName(name)
    for _, s in ipairs(KillSounds) do if s.Name == name then return s.Id end end
    return KillSounds[1].Id
end

local function PlayKillSound()
    if not SOUND.KillSoundEnabled then return end
    KillSoundPlayer:Stop()
    KillSoundPlayer.SoundId = "rbxassetid://" .. GetKillSoundIdByName(SOUND.SelectedKillSound)
    KillSoundPlayer.Volume = SOUND.KillSoundVolume
    KillSoundPlayer:Play()
end

local function TryPlayKillSound()
    if not SOUND.KillSoundEnabled then return end
    local now = tick()
    if now - SOUND.lastKillSoundTime < 0.08 then return end
    SOUND.lastKillSoundTime = now
    PlayKillSound()
end

local function PlayShootSound()
    if not SOUND.ShootSoundEnabled then return end
    if tick() - SOUND.lastEquipTime < SOUND.equipGraceTime then return end
    local id = ShootSounds[SOUND.SelectedShootSound]
    if not id then return end
    local now = tick()
    if now - SOUND.lastShootSoundTime < SOUND.shootBurstCooldown then return end
    SOUND.lastShootSoundTime = now
    SOUND.shootSoundToken = SOUND.shootSoundToken + 1
    local myToken = SOUND.shootSoundToken
    ShootSoundPlayer:Stop()
    ShootSoundPlayer.SoundId = "rbxassetid://" .. id
    ShootSoundPlayer.Volume = SOUND.ShootSoundVolume
    ShootSoundPlayer:Play()
    task.delay(1.5, function()
        if SOUND.shootSoundToken == myToken and ShootSoundPlayer.Playing then
            ShootSoundPlayer:Stop()
        end
    end)
end

