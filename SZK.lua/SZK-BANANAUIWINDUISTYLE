local function canTargetPlayer(p)
	if p == LP then return false end
	local char = p.Character
	if not char then return false end
	if not isEnemy(char) then return false end
	if IsSameTeam(p) then return false end
	if IsObby(p) then return false end
	if char:FindFirstChildOfClass("ForceField") then return false end
	if p.Team then
		local tName = string.lower(p.Team.Name)
		if string.find(tName, "lobby") or string.find(tName, "spectat") or string.find(tName, "menu") or string.find(tName, "dead") then return false end
	end
	return true
end

local hasHooks = (typeof(hookfunction) == "function") and (typeof(hookmetamethod) == "function")
local checkcaller = checkcaller or function() return false end
local newcclosure = newcclosure or function(f) return f end
local getnamecallmethod = getnamecallmethod or function() return "" end

if hasHooks and not getgenv().NexvyrHookIniciado then
	getgenv().NexvyrHookIniciado = true
	local oldNC
	oldNC = hookmetamethod(game, "__namecall", function(self, ...)
		if not checkcaller() and self == workspace and getgenv().NexvyrTargetPart then
			local method = getnamecallmethod()
			local target = getgenv().NexvyrTargetPart
			if target and target.Parent then
				if method == "Raycast" then
					local args = {...}
					local origin, direction = args[1], args[2]
					if typeof(direction) == "Vector3" and direction.Magnitude > 20 then
						local camPos = Workspace.CurrentCamera.CFrame.Position
						if (origin - camPos).Magnitude >= 1 then return oldNC(self, origin, (target.Position - origin).Unit * 5000, args[3]) end
					end
				elseif typeof(method) == "string" and method:sub(1, 13) == "FindPartOnRay" then
					local args = {...}
					local ray = args[1]
					if typeof(ray) == "Ray" and ray.Direction.Magnitude > 20 then
						local camPos = Workspace.CurrentCamera.CFrame.Position
						if (ray.Origin - camPos).Magnitude >= 1 then return oldNC(self, Ray.new(ray.Origin, (target.Position - ray.Origin).Unit * 5000), args[2], args[3], args[4]) end
					end
				end
			else getgenv().NexvyrTargetPart = nil end
		end
		return oldNC(self, ...)
	end)
end

