local function applyTheme(theme)
	for k, v in pairs(theme) do if typeof(v) == "Color3" then T[k] = v end end
	T.Red = Color3.fromRGB(0,0,0); T.Orange = Color3.fromRGB(45,45,45); T.Green = Color3.fromRGB(255,255,255)
	for i = #Registry, 1, -1 do local r = Registry[i]; if r[1].Parent == nil then table.remove(Registry, i) else r[1][r[2]] = T[r[3]] end end
	for i = #GradReg, 1, -1 do local g = GradReg[i]; if g[1].Parent == nil then table.remove(GradReg, i) else g[1].Color = g[2]() end end
	for _, f in ipairs(Updaters) do pcall(f) end
end

