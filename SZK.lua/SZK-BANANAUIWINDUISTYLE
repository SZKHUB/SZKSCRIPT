local function isEnemy(model)
	if not model or typeof(model) ~= "Instance" or not model:IsA("Model") then return false end
	if model == LP.Character then return false end
	if not model.Parent then return false end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0.05 then return false end
	if hum:GetState() == Enum.HumanoidStateType.Dead or hum:GetState() == Enum.HumanoidStateType.FallingDown then return false end
	local hrp, head = model:FindFirstChild("HumanoidRootPart"), model:FindFirstChild("Head")
	if not hrp or not head then return false end
	if hrp.Anchored and head.Anchored then return false end
	local plr = Players:GetPlayerFromCharacter(model)
	if plr then
		if plr.Parent ~= Players or plr.Character ~= model then return false end
		if plr:GetAttribute("IsDead") == true then return false end
	end
	return true
end

local function getEnemies()
	local list, seen = {}, {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP and plr.Character and isEnemy(plr.Character) then list[#list + 1] = plr.Character; seen[plr.Character] = true end
	end
	for _, child in ipairs(Workspace:GetChildren()) do
		if not seen[child] and isEnemy(child) then list[#list + 1] = child; seen[child] = true end
	end
	return list
end

local function getTargetPart(model) if not model then return nil end; return model:FindFirstChild(Shared.TargetPart) or model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") end

local function hasLineOfSight(part)
	if not part or not Camera then return false end
	local origin = Camera.CFrame.Position
	local dir = part.Position - origin
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local filter = { LP.Character }
	if part.Parent then table.insert(filter, part.Parent) end
	rp.FilterDescendantsInstances = filter
	rp.IgnoreWater = true
	local hit = Workspace:Raycast(origin, dir, rp)
	if hit and hit.Instance then return hit.Instance:IsDescendantOf(part.Parent) end
	return true
end

local function getScoreboard()
	local pg = LP:FindFirstChild("PlayerGui"); if not pg then return nil end
