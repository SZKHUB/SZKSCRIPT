local tabs, activeTab = {}, nil
local function paintTabs()
	for _, t in ipairs(tabs) do
		local a = (t == activeTab)
		t.Button.BackgroundColor3 = a and T.Accent or T.Element
		t.Button.TextColor3 = a and T.OnAccent or T.Sub
		if t.Indicator then tween(t.Indicator, 0.22, {Size = UDim2.new(0, a and 3 or 0, 0, 20)}) end
		if t.ButtonStroke then tween(t.ButtonStroke, 0.25, {Transparency = a and 0.3 or 1}) end
	end
end
table.insert(Updaters, paintTabs)
local function selectTab(tab)
	if tab == activeTab then return end
	activeTab = tab
	for _, t in ipairs(tabs) do
		local a = (t == tab)
		t.Page.Visible = a
		tween(t.Button, 0.15, {BackgroundColor3 = a and T.Accent or T.Element, TextColor3 = a and T.OnAccent or T.Sub})
		if t.Indicator then tween(t.Indicator, 0.22, {Size = UDim2.new(0, a and 3 or 0, 0, 20)}, Enum.EasingStyle.Back) end
		if t.ButtonStroke then tween(t.ButtonStroke, 0.25, {Transparency = a and 0.3 or 1}) end
	end
	tab.Page.Position = UDim2.new(0, 14, 0, 0)
	tween(tab.Page, 0.22, {Position = UDim2.new(0, 0, 0, 0)})
	Config.__tab = tab.Name; saveConfig()
end

