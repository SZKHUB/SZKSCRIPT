local minimized = (Config.__min == true)
local minBusy = false
local function fade(obj, show, instant)
	local props = {TextTransparency = show and 0 or 1}
	if obj:IsA("TextButton") then props.BackgroundTransparency = show and 0 or 1 end
	if instant then for k, v in pairs(props) do obj[k] = v end; obj.Visible = show; return end
	if show then obj.Visible = true end
	tween(obj, 0.2, props).Completed:Connect(function(state) if state == Enum.PlaybackState.Completed and not show then obj.Visible = false end end)
end
local function applyMin(v, instant)
	local shift = (HEIGHT - TOPH) / 2
	local p = Main.Position
	local size = UDim2.new(0, v and MINW or WIDTH, 0, v and TOPH or HEIGHT)
	local pos = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + (v and -shift or shift))
	local minPos = UDim2.new(1, v and -104 or -180, 0.5, -13)
	local closePos = UDim2.new(1, v and -70 or -144, 0.5, -13)
	local iconSize = v and UDim2.new(0, 10, 0, 10) or UDim2.new(0, 10, 0, 2)
	local iconFill, iconLine = v and 1 or 0, v and 0 or 1
	local iconRadius = UDim.new(0, v and 3 or 1)
	if v == false then Content.Visible = true end
	if instant then
		Main.Size, Main.Position = size, pos
		MinBtn.Position, CloseBtn.Position = minPos, closePos
		MinIcon.Size, MinIcon.BackgroundTransparency, MinIconStroke.Transparency, MinIconCorner.CornerRadius = iconSize, iconFill, iconLine, iconRadius
		Content.Visible = not v
		fade(DeleteBtn, not v, true); fade(VersionLbl, not v, true); fade(fpsLabel, not v, true)
		return
	end
	tween(Main, 0.35, {Size = size, Position = pos}, Enum.EasingStyle.Quart)
	tween(MinBtn, 0.35, {Position = minPos}, Enum.EasingStyle.Quart)
	tween(CloseBtn, 0.35, {Position = closePos}, Enum.EasingStyle.Quart)
	tween(MinIcon, 0.25, {Size = iconSize, BackgroundTransparency = iconFill}, Enum.EasingStyle.Back)
	tween(MinIconStroke, 0.25, {Transparency = iconLine})
	tween(MinIconCorner, 0.25, {CornerRadius = iconRadius})
	fade(DeleteBtn, not v); fade(VersionLbl, not v); fade(fpsLabel, not v)
	if v then task.delay(0.3, function() if minimized then Content.Visible = false end end) end
end
local function setMinimized(v)
	if minBusy or v == minimized or not isOpen then return end
	minBusy = true; minimized = v; Config.__min = v; saveConfig()
	applyMin(v, false)
	task.delay(0.4, function() minBusy = false end)
end
