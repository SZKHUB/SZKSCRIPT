local function Notify(title, text, duration, kind)
	if not NotifEnabled and kind ~= "error" then return end
	duration = duration or 3
	local single = (text == nil or text == "")
	notifOrder += 1
	local n = new("Frame", {Size = UDim2.new(1, 0, 0, single and 42 or 58), BackgroundColor3 = "@Panel", BorderSizePixel = 0, BackgroundTransparency = 1, ClipsDescendants = true, LayoutOrder = notifOrder, ZIndex = 91}, NotifHolder)
	corner(n, 12)
	local nScale = new("UIScale", {Scale = 0.85}, n)
	local nOffset = new("UIPadding", {PaddingRight = UDim.new(0, 20)}, n)
	local s = stroke(n, Color3.new(1, 1, 1), kind == "error" and 2.2 or 1.2, 1)
	local bar = new("Frame", {Size = UDim2.new(0, 3, 1, -18), Position = UDim2.new(0, 9, 0, 9), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 92}, n)
	corner(bar, 2); gradient(bar, 90)
	local t1 = label({Size = single and UDim2.new(1, -32, 1, 0) or UDim2.new(1, -32, 0, 18), Position = single and UDim2.new(0, 22, 0, 0) or UDim2.new(0, 22, 0, 9), Text = title, Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, ZIndex = 92}, n)
	local t2
	if not single then t2 = label({Size = UDim2.new(1, -32, 0, 18), Position = UDim2.new(0, 22, 0, 30), Text = text, Font = Enum.Font.Gotham, TextColor3 = "@Sub", TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, ZIndex = 92}, n) end
	local prog = new("Frame", {Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.4, ZIndex = 92}, n)
	local click = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 93}, n)
	nOffset.PaddingRight = UDim.new(0, 40)
	tween(n, 0.3, {BackgroundTransparency = 0}); tween(s, 0.3, {Transparency = 0.4})
	tween(nScale, 0.35, {Scale = 1}, Enum.EasingStyle.Back)
	tween(nOffset, 0.3, {PaddingRight = UDim.new(0, 0)}, Enum.EasingStyle.Quart)
	tween(t1, 0.3, {TextTransparency = 0})
	if t2 then tween(t2, 0.3, {TextTransparency = 0}) end
	tween(prog, duration, {Size = UDim2.new(0, 0, 0, 2)}, Enum.EasingStyle.Linear)
	local done = false
	local function dismiss()
		if done then return end; done = true
		tween(n, 0.25, {BackgroundTransparency = 1}); tween(s, 0.25, {Transparency = 1})
		tween(nScale, 0.25, {Scale = 0.85}); tween(nOffset, 0.25, {PaddingRight = UDim.new(0, 40)})
		tween(t1, 0.25, {TextTransparency = 1}); tween(prog, 0.25, {BackgroundTransparency = 1})
		if t2 then tween(t2, 0.25, {TextTransparency = 1}) end
		task.wait(0.3); n:Destroy()
	end
	task.delay(duration, dismiss)
	click.MouseButton1Click:Connect(function() task.spawn(dismiss) end)
end

