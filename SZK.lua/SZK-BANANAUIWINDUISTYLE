local isOpen, busy = false, false
local function setOpen(v)
	if busy or v == isOpen then return end
	busy = true; isOpen = v
	if v then
		OpenBtn.Visible = false; Main.Visible = true
		tween(Scale, 0.35, {Scale = UserScale}, Enum.EasingStyle.Back).Completed:Connect(function() busy = false end)
	else
		tween(Scale, 0.2, {Scale = 0}, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Connect(function()
			Main.Visible = false
			OpenScale.Scale = 0; OpenBtn.Visible = true
			tween(OpenScale, 0.3, {Scale = 1}, Enum.EasingStyle.Back)
			busy = false
		end)
	end
end
