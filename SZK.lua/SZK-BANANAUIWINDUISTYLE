local function HookAnySound(s)
    if not s:IsA("Sound") then return end
    if isMySound(s) then return end
    if SOUND.ShootSoundEnabled and SOUND.MuteOriginalShoot and shouldMuteSound(s) then
        muteSound(s)
    end
    if s:GetAttribute("SZ_SoundHooked") then return end
    s:SetAttribute("SZ_SoundHooked", true)
    s.Played:Connect(function()
        if not SOUND.ShootSoundEnabled then return end
        if isMySound(s) then return end
        if not isRealFireSound(s) then return end
        if not isInMyTool(s) then return end
        if SOUND.MuteOriginalShoot then muteSound(s) end
        PlayShootSound()
    end)
end

