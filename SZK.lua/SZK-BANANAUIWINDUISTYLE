local function ResetAllFeatures()
	Aim.Enabled = false; autoShootEnabled = false; autoShootAgresivoEnabled = false
	silentAimManualEnabled = false; silentAimFovEnabled = false
	equipGunEnabled = false; hitboxEnabled = false; hitboxInvisible = false
	Esp.Enabled = false; Esp.Tracer = false; AutoEventFarm = false; showFovCircle = false
	getgenv().NexvyrTargetPart = nil
	clearHitboxes()
	for plr in pairs(ESP_Data) do destroyESP(plr) end
	SUPPRESS_SAVE = true
	for k, v in pairs(Config) do if type(v) == "boolean" then Config[k] = false end end
	for _, w in ipairs(WidgetRegistry) do if w.flag and type(Config[w.flag]) == "boolean" then pcall(w.sync, false) end end
	SUPPRESS_SAVE = false
	AllConfigs[CurrentConfigName] = Config; writeAllConfigs()
	Notify("Reset", "All features OFF", 2, "success")
end

