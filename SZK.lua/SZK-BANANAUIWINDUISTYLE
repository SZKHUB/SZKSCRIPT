    if parentGui and (string.find(parentGui.Name, "WindUI") or string.find(parentGui.Name, "BANANA") or string.find(parentGui.Name, "SZK")) then return end

    if v:IsA("TextLabel") or v:IsA("TextBox") or v:IsA("TextButton") then
        local myName = LP.Name
        local myDisp = LP.DisplayName

        if not originalTextsOrby[v] then
            if string.find(v.Text, myName) or string.find(v.Text, myDisp) then
                originalTextsOrby[v] = { Text = v.Text, Color = v.TextColor3, Trans = v.TextTransparency }
            end
        end

        local data = originalTextsOrby[v]
        if data then
            if hideNameEnabled then
                v.Text = ""
                v.TextTransparency = 1
            elseif fakeNameEnabled or creatorTagEnabled then
                v.TextTransparency = data.Trans
                v.TextColor3 = data.Color
                local baseName = fakeNameEnabled and spoofNameText or myDisp
                local isOverhead = false
                if LP.Character and v:IsDescendantOf(LP.Character) then
                    isOverhead = true
                else
                    local bill = v:FindFirstAncestorWhichIsA("BillboardGui")
                    if bill and bill.Adornee and LP.Character and bill.Adornee:IsDescendantOf(LP.Character) then
                        isOverhead = true
                    end
                end
                if creatorTagEnabled and isOverhead then
                    v.RichText = true
                    v.Text = '<font color="#bee1e7">[Content Creator]</font> ' .. baseName
                else
                    v.Text = baseName
                end
            else
                v.Text = data.Text
                v.TextColor3 = data.Color
                v.TextTransparency = data.Trans
            end
        end
    end
end

local function refreshAllTexts()
    local pGui = LP:FindFirstChild("PlayerGui")
    if pGui then for _, v in ipairs(pGui:GetDescendants()) do processOrbyText(v) end end
    if LP.Character then for _, v in ipairs(LP.Character:GetDescendants()) do processOrbyText(v) end end
end

