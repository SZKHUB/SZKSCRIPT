local function new(class, props, par)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if type(v) == "string" and v:sub(1, 1) == "@" and k:find("Color") then
			local role = v:sub(2); o[k] = T[role]; table.insert(Registry, {o, k, role})
		else o[k] = v end
	end
	if par then o.Parent = par end
	return o
end
local function corner(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, o) end
local function stroke(o, c, t, tr) return new("UIStroke", {Color = c or "@Accent", Thickness = t or 1, Transparency = tr or 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o) end
local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play(); return tw
end
local function gradient(o, rot, fn)
	fn = fn or function() return ColorSequence.new(T.Accent, T.Accent2) end
	local g = new("UIGradient", {Color = fn(), Rotation = rot or 0}, o)
	table.insert(GradReg, {g, fn}); return g
