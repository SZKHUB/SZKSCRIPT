local function refreshTeams()
	local snap = {}
	local score = getScoreboard()
	if score then
		for _, fName in ipairs({"TeamRed","TeamBlue"}) do
			local folder = score:FindFirstChild(fName)
			if folder then
				local team = (fName == "TeamRed") and "Red" or "Blue"
				for _, entry in ipairs(folder:GetChildren()) do snap[string.lower(entry.Name)] = team end
			end
		end
	end
	return snap
end
local function getPlayerTeam(target)
	if not target then return nil end
	local snap = refreshTeams()
	local t = snap[string.lower(target.Name)]
	if not t and target.DisplayName then t = snap[string.lower(target.DisplayName)] end
	return t
end

local function IsSameTeam(plr)
	if not plr then return false end
	if plr == LP then return false end
	local myTeam = LP.Team or LP:GetAttribute("Team")
	local targetTeam = plr.Team or plr:GetAttribute("Team")
	if myTeam and targetTeam and myTeam == targetTeam then return true end
	local myTeamName = getPlayerTeam(LP) or string.lower(LP.Name)
	local targetTeamName = getPlayerTeam(plr) or string.lower(plr.Name)
	return myTeamName == targetTeamName
end

local function IsObby(plr)
	if not plr then return false end
	if plr == LP then return false end
	local char = plr.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	local moveDir = hum.MoveDirection
	if moveDir.Magnitude > 0 then return false end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	local isObby = false
	local obstacles = {"Obstacles", "Obstacle", "Part", "Block", "Floor", "Wall", "Ground", "Platform", "PlatformStart", "PlatformEnd", "Finish", "End"}
	for _, obs in ipairs(obstacles) do
		local found = char:FindFirstChild(obs)
		if found then isObby = true; break end
	end
	local groundCheck = hrp.Position.Y < 50 and hrp.AssemblyLinearVelocity.Magnitude < 0.1
	return isObby or groundCheck
end

